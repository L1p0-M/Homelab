{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automergeType": "pr",
  "timezone": "Europe/Budapest"
  "recreateWhen": "never",
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Renovate/VERSION$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\\s*$"
      ],
      "depNameTemplate": "ghcr.io/l1p0-m/renovate-cron",
      "packageNameTemplate": "renovate/renovate",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/**",
        "ghcr.io/linuxserver/**",
        "linuxserver/**"
      ],
      "pinDigests": true,
      "digest": {
        "enabled": true
      }
    },
    {
      "matchPackageNames": ["renovate/renovate"],
      "groupName": "Renovate",
      "commitMessageTopic": "Renovate: {{{depName}}}",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* 8-12 * * 1"],
      "automerge": true
    },
    {
      "description": "Dockerfiles to one pr/file",
      "matchManagers": ["dockerfile"],
      "separateMajorMinor": true,
      "commitMessageTopic": "Dockerfile: {{{depName}}}",
      "matchPackageNames": [
        "!renovate/renovate"
      ]
    },
    {
      "description": "Docker Compose fles to one groupped pr",
      "matchManagers": ["docker-compose"],
      "groupName": "Docker Compose dependencies",
      "commitMessageTopic": "Docker Compose: {{{depName}}}"
    }
  ],
  "hostRules": [
    {
      "matchHost": "lscr.io",
      "maxRequestsPerSecond": 2
    }
  ]
}
