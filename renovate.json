{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "recreateWhen": "auto",
  "enabledManagers": [
    "docker-compose"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "groupName": "Docker containers"
    }
  ]
}
