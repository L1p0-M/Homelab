{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automergeType": "pr",
  "timezone": "Europe/Budapest",
  "recreateWhen": "never",
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "lscr.io/linuxserver/**",
        "ghcr.io/linuxserver/**",
        "linuxserver/**",
        "ghcr.io/l1p0-m/github-runner**"
      ],
      "pinDigests": true,
      "digest": {
        "enabled": true
      }
    },
    {
      "matchPackageNames": ["renovate/renovate", "ghcr.io/l1p0-m/renovate-cron"],
      "groupName": "Renovate",
      "commitMessageTopic": "Renovate: {{{depName}}}",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* 8-12 * * 1"],
      "automerge": true
    },
    {
      "description": "Docker Compose fles to one groupped pr",
      "matchManagers": ["docker-compose"],
      "groupName": "Docker Compose dependencies",
      "commitMessageTopic": "Docker Compose: {{{depName}}}"
    }
  ],
  "hostRules": [
    {
      "matchHost": "lscr.io",
      "maxRequestsPerSecond": 2
    }
  ]
}
