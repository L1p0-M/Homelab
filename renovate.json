{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "recreateWhen": "never",
  "enabledManagers": [
    "docker-compose",
    "dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^VERSION$"],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)"
      ],
      "depNameTemplate": "renovate/renovate",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["renovate/renovate"],
      "groupName": "Renovate updates",
      "commitMessageTopic": "Renovate: Update Version"
    }
  ],
  "packageRules": [
    {
      "description": "Dockerfiles to one pr/file",
      "matchManagers": ["dockerfile"],
      "separateMajorMinor": true,
      "commitMessageTopic": "Dockerfile: Update {{{depName}}} version"
    },
    {
      "description": "Docker Compose fles to one groupped pr",
      "matchManagers": ["docker-compose"],
      "groupName": "Docker Compose dependencies",
      "commitMessageTopic": "Docker Compose: Update {{{depName}}} version"
    }
  ]
}
