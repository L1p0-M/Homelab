{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "recreateWhen": "never",
  "enabledManagers": [
    "docker-compose"
  ],
  "packageRules": [
    {
      "groupName": "Docker containers",
      "matchPackageNames": [
        "*"
      ]
    }
  ]
}
